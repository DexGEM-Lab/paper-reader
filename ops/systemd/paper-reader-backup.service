[Unit]
Description=Paper Reader S3 snapshot backup
Wants=network-online.target
After=network-online.target
OnFailure=paper-reader-backup-failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/paper-reader/scripts/backup-to-s3.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/paper-reader/backups

[Install]
WantedBy=multi-user.target
